# Optional. When set, location sheets can show live Google ratings/photos
# on-demand. The "View on Maps" link works without any key.
# Add the real value as a Cloudflare secret for production:
#   npx wrangler pages secret put GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=

# Optional. A Maps Embed API key enables the in-app Street View panel.
# Without it the panel is not offered; "Open in Maps" still works.
PUBLIC_GOOGLE_MAPS_KEY=""
